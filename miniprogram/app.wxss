/* ===== 设计 token：宣纸 · 水墨 · 墨蓝 · 青磁 · 朱砂 ===== */
page {
  --paper: #F6F1E4;        /* 宣纸底 */
  --card: #FFFDF6;         /* 卡片底 */
  --ink: #2A2620;          /* 墨色正文 */
  --ink-soft: #4A443A;     /* 墨色次级 */
  --primary: #2F4A6E;      /* 墨蓝主色 */
  --celadon: #4F716A;      /* 青磁辅色：浅底文字对比度 >= 4.5 */
  --cinnabar: #A03B2C;     /* 朱砂暗红（仅里程碑/徽章/印章） */
  --gray: #6F685F;         /* 辅助灰：浅底文字对比度 >= 4.5 */
  --line: #E4DDCB;         /* 分隔线 */
  --radius: 24rpx;
  --font-sans: "Noto Sans SC", "Noto Sans CJK SC", "Source Han Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-display: "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "Songti SC", "STSong", serif;

  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 30rpx;
  line-height: 1.6;
}

/* ===== 通用布局 ===== */
.page-body {
  padding: 24rpx 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-tap-hover { opacity: 0.76; }

.title-lg { font-size: 40rpx; font-weight: 600; color: var(--ink); }
.title-md { font-size: 34rpx; font-weight: 600; color: var(--ink); }
.title-sm { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.text-soft { color: var(--ink-soft); }
.text-gray { color: var(--gray); font-size: 26rpx; }
.text-primary { color: var(--primary); }

/* 词作原文：清晰无衬线字体 + 舒展行高 */
.ci-text {
  font-family: var(--font-sans);
  font-size: 34rpx;
  line-height: 1.8;
  color: var(--ink);
}

/* 朱砂印章式小徽章 */
.seal {
  display: inline-block;
  color: #FFFDF6;
  background: var(--cinnabar);
  border-radius: 8rpx;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  line-height: 1.6;
}

/* 墨蓝标签 */
.chip {
  display: inline-block;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 2rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
}

.divider { height: 1rpx; background: var(--line); margin: 20rpx 0; }

/* 一级入口按钮卡 */
.entry-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.entry-card-hover { background: #F2EBDC; }
.entry-emoji { font-size: 44rpx; margin-right: 24rpx; }
.entry-main { flex: 1; }
.entry-title { font-size: 32rpx; font-weight: 600; }
.entry-desc { font-size: 26rpx; color: var(--gray); margin-top: 4rpx; }
.entry-arrow { color: var(--gray); font-size: 30rpx; }
