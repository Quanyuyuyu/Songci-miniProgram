.page-intro {
  font-size: 26rpx;
  color: var(--gray);
  line-height: 1.7;
  margin-bottom: 24rpx;
}
.hint-card { border-left: 6rpx solid var(--celadon); }
.hint-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.hint-text { font-size: 26rpx; color: var(--ink-soft); margin-top: 10rpx; line-height: 1.7; }
.loading-hint { text-align: center; color: var(--gray); font-size: 26rpx; padding: 80rpx 0; }
