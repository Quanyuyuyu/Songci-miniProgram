<view class="page-body">
  <empty-state wx:if="{{error}}" icon="📖" title="词目数据未能加载" reason="{{error}}" />
  <empty-state wx:if="{{!loading && !error && !weeks.length}}" icon="📖" title="暂无阅读词目" reason="阅读周历尚未收录内容" />

  <block wx:if="{{!loading && weeks.length}}">
    <view class="schedule-note" wx:if="{{notice}}">{{notice}}</view>

    <view class="week-block" wx:for="{{weeks}}" wx:key="week" wx:for-item="weekItem">
      <view class="week-head">
        <view class="week-no">W{{weekItem.week}}</view>
        <view class="week-topic">{{weekItem.topic}}</view>
        <view class="week-count">{{weekItem.items.length}} 首</view>
      </view>
      <view class="card ci-row" wx:for="{{weekItem.items}}" wx:key="ci_id" wx:for-item="ci" data-id="{{ci.ci_id}}" bindtap="goDetail">
        <view class="ci-head">
          <text class="ci-cipai">{{ci.cipai}}</text>
          <text class="ci-title" wx:if="{{ci.title}}">· {{ci.title}}</text>
        </view>
        <view class="ci-author">{{ci.dynasty}} · {{ci.author}}</view>
        <view class="ci-go">原文、简注与导读 ›</view>
      </view>
    </view>

    <disclaimer-bar />
  </block>

  <view wx:if="{{loading}}" class="loading-hint">加载中…</view>
</view>
