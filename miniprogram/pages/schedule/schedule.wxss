.rule-bar {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-left: 6rpx solid var(--celadon);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-bottom: 24rpx;
}
.seg {
  display: flex;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 16rpx 0;
  color: var(--gray);
}
.seg-on { background: var(--primary); color: #FFFDF6; font-weight: 600; }

.week-notice { font-size: 26rpx; color: var(--primary); font-weight: 600; margin-bottom: 20rpx; }

.ci-row { padding: 24rpx 28rpx; }
.ci-head { display: flex; align-items: baseline; flex-wrap: wrap; }
.ci-cipai { font-size: 32rpx; font-weight: 600; color: var(--primary); }
.ci-title { font-size: 28rpx; color: var(--ink); margin-left: 6rpx; }
.ci-head .seal { margin-left: 12rpx; }
.seal-blue { background: var(--primary); }
.ci-author { font-size: 24rpx; color: var(--gray); margin-top: 6rpx; }
.ci-go { font-size: 24rpx; color: var(--celadon); margin-top: 10rpx; }

.lesson-block { margin-bottom: 8rpx; }
.lesson-head {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin: 28rpx 0 16rpx;
}
.lesson-head-cur { color: var(--cinnabar); }
.lesson-head .seal { margin-left: 12rpx; }

.loading-hint { text-align: center; color: var(--gray); font-size: 26rpx; padding: 80rpx 0; }
