.schedule-note {
  padding: 18rpx 22rpx;
  border-left: 5rpx solid var(--celadon);
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-bottom: 24rpx;
  line-height: 1.7;
}
.week-block { margin-bottom: 34rpx; }
.week-head {
  display: flex;
  align-items: baseline;
  margin: 0 2rpx 14rpx;
}
.week-no { width: 62rpx; color: var(--cinnabar); font-size: 25rpx; font-weight: 600; }
.week-topic { flex: 1; color: var(--ink); font-size: 31rpx; font-weight: 600; }
.week-count { color: var(--gray); font-size: 22rpx; }

.ci-row { padding: 22rpx 26rpx; margin-bottom: 14rpx; }
.ci-head { display: flex; align-items: baseline; flex-wrap: wrap; }
.ci-cipai { font-size: 32rpx; font-weight: 600; color: var(--primary); }
.ci-title { font-size: 28rpx; color: var(--ink); margin-left: 6rpx; }
.ci-author { font-size: 24rpx; color: var(--gray); margin-top: 6rpx; }
.ci-go { font-size: 24rpx; color: var(--celadon); margin-top: 10rpx; }

.loading-hint { text-align: center; color: var(--gray); font-size: 26rpx; padding: 80rpx 0; }
