<view class="page-body">
  <empty-state wx:if="{{error}}" icon="📝" title="任务数据未能加载" reason="{{error}}" />

  <!-- ============ 拍照配词 ============ -->
  <block wx:if="{{!loading && type === 'photo' && photo}}">
    <section-head title="是什么" />
    <view class="card"><view class="para">{{photo.what}}</view></view>

    <section-head title="要求" />
    <view class="card">
      <view class="req" wx:for="{{photo.requirements}}" wx:key="index">· {{item}}</view>
      <view class="req-note">{{photo.submit_note}}</view>
    </view>

    <section-head title="交之前逐项自检" />
    <view class="card">
      <checklist items="{{photo.checklist}}" store-key="{{chkPhotoKey}}" />
    </view>

    <section-head title="两种交付形式" />
    <view class="card deliver" wx:for="{{photo.deliver}}" wx:key="form">
      <view class="deliver-form">{{item.form}}</view>
      <view class="deliver-submit">提交物：{{item.submit}}</view>
      <view class="deliver-points">展示要点：{{item.points}}</view>
    </view>

    <section-head title="里程碑" sub="只有顺序，没有日期" />
    <view class="card">
      <milestone-list items="{{photo.milestones}}" note="具体时间以课程群通知为准" />
    </view>

    <view class="link-card card card-tap" bindtap="goArchive"
          hover-class="card-tap-hover" hover-start-time="20" hover-stay-time="80">
      <view class="link-title">看范例 · 优秀拍照配词</view>
      <view class="link-desc">往届做成过什么样 ›</view>
    </view>
  </block>

  <!-- ============ 讨论课展示 ============ -->
  <block wx:if="{{!loading && type === 'discussion' && discussion}}">
    <section-head title="历学期主题" />
    <view class="card theme-card {{item.status === 'known' ? 'theme-known' : ''}}"
          wx:for="{{discussion.themes}}" wx:key="term">
      <view class="theme-term">{{item.display}}</view>
      <block wx:if="{{item.status === 'known'}}">
        <view class="theme-title">{{item.title}}</view>
        <view class="para">{{item.desc}}</view>
        <view class="theme-meta">
          <text class="chip">{{item.group_rule}}</text>
          <text class="chip">{{item.duration}}</text>
        </view>
      </block>
      <view class="theme-pending" wx:elif="{{item.status === 'pending'}}">主题尚未发布</view>
      <view class="theme-uncollected" wx:else>主题资料暂未收录</view>
    </view>

    <view class="pending-note" wx:if="{{discussion.themes[0].status === 'pending'}}">
      2026 秋具体安排以课程群通知为准
    </view>

    <section-head title="展示前的三步" />
    <view class="card">
      <milestone-list items="{{discussion.milestones}}" note="{{discussion.milestones_note}}" />
    </view>

    <section-head title="准备清单" />
    <view class="card">
      <milestone-list items="{{discussion.prepare}}" />
    </view>
  </block>

  <!-- ============ 期末习作 ============ -->
  <block wx:if="{{!loading && type === 'final' && final}}">
    <section-head title="是什么" />
    <view class="card">
      <view class="para">{{final.what}}</view>
      <view class="form-chips">
        <text class="chip" wx:for="{{final.forms}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <section-head title="要求" />
    <view class="card">
      <view class="req">· {{final.min_words_note}}</view>
      <view class="req">· {{final.naming_note}}</view>
      <view class="req">· 如利用 AI 写作，请提前与任课老师沟通，或清晰标注在习作中</view>
      <view class="copy-row" bindtap="onCopyNaming">
        <text class="copy-btn">复制命名格式「{{final.naming}}」</text>
      </view>
      <view class="req-note">{{final.submit_note}}</view>
    </view>

    <section-head title="学术规范自检" />
    <view class="card">
      <checklist items="{{final.integrity}}" store-key="{{chkFinalKey}}" />
    </view>

    <section-head title="里程碑" sub="只有顺序，没有日期" />
    <view class="card">
      <milestone-list items="{{final.milestones}}" note="迟交代价：{{final.late_penalty}}" />
    </view>

    <view class="link-card card card-tap" bindtap="goNotes"
          hover-class="card-tap-hover" hover-start-time="20" hover-stay-time="80">
      <view class="link-title">攒词作体悟 · 我的笔记</view>
      <view class="link-desc">期末可由平时积累的阅读体悟连缀成文 ›</view>
    </view>

    <view class="link-card card card-tap" bindtap="goArchive"
          hover-class="card-tap-hover" hover-start-time="20" hover-stay-time="80">
      <view class="link-title">看范例 · 优秀期末习作</view>
      <view class="link-desc">往届写成过什么样 ›</view>
    </view>
  </block>

  <disclaimer-bar />
  <view wx:if="{{loading}}" class="loading-hint">加载中…</view>
</view>
