<view class="page-body">
  <empty-state wx:if="{{error}}" icon="🗂" title="档案数据未能加载" reason="{{error}}" />

  <block wx:if="{{!loading}}">
    <view class="archive-return" wx:if="{{returnTarget}}" bindtap="onReturn"
          hover-class="card-tap-hover" hover-start-time="20" hover-stay-time="80">
      <text class="return-icon">←</text>
      <text>{{returnTarget.label}}</text>
    </view>
    <view class="page-intro">往届学长学姐做成过什么样——看的是「什么样算做得好」，不是拿来抄。</view>

    <!-- 学期卡片 -->
    <section-head title="六个学期" />
    <view class="term-grid">
      <view class="term-card {{activeTerm === item.term ? 'term-active' : ''}}"
            wx:for="{{terms}}" wx:key="term"
            data-term="{{item.term}}" bindtap="onTermTap"
            hover-class="term-card-hover" hover-start-time="20" hover-stay-time="80">
        <view class="term-display">{{item.display}}</view>
        <view class="term-status {{activeTerm === item.term ? 'term-status-active' : ''}}">
          {{item.statusText}}
        </view>
      </view>
    </view>

    <!-- 优秀作品 -->
    <section-head title="优秀作品" sub="{{activeCategory === 'creative' ? '创意作品跨学期展示' : activeTermDisplay}}" />
    <view class="cat-bar">
      <view class="cat-chip {{activeCategory === item.key ? 'cat-chip-on' : ''}}"
            wx:for="{{categories}}" wx:key="key"
            data-key="{{item.key}}" bindtap="onCategoryTap">{{item.label}}</view>
    </view>
    <view class="cat-desc" wx:for="{{categories}}" wx:key="key" wx:if="{{activeCategory === item.key}}">{{item.desc}}</view>

    <empty-state wx:if="{{!works.length}}" icon="🗂" title="暂未收录" reason="{{activeTermDisplay}}尚未收录该类作品" />
    <view class="work-card card card-tap" wx:for="{{works}}" wx:key="id" data-id="{{item.id}}" bindtap="onWorkTap"
          hover-class="card-tap-hover" hover-start-time="20" hover-stay-time="80">
      <view class="work-head">
        <view class="work-title">{{item.title}}</view>
        <view class="seal" wx:if="{{item.form_tag}}">{{item.form_tag}}</view>
      </view>
      <view class="work-brief" wx:if="{{item.brief}}">{{item.brief}}</view>
      <view class="work-meta" wx:if="{{item.termDisplay}}">收录学期：{{item.termDisplay}}</view>
    </view>

    <view class="archive-note">{{note}}</view>
    <disclaimer-bar />
  </block>

  <view wx:if="{{loading}}" class="loading-hint">加载中…</view>
</view>
