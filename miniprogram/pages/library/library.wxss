.book-title { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.book-meta { font-size: 26rpx; color: var(--ink-soft); margin-top: 8rpx; }
.book-isbn { font-size: 24rpx; color: var(--gray); margin-top: 8rpx; }
.books-note { font-size: 24rpx; color: var(--gray); margin: 4rpx 0 12rpx; }
.reading-card { display: flex; align-items: center; }
.reading-card-hover { background: #F2EBDC; }
.reading-main { flex: 1; min-width: 0; }
.reading-arrow { width: 44rpx; flex-shrink: 0; margin-left: 16rpx; color: var(--cinnabar); font-size: 40rpx; line-height: 1; text-align: center; }
.about-link {
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
  padding: 24rpx 0 8rpx;
}
.loading-hint { text-align: center; color: var(--gray); font-size: 26rpx; padding: 80rpx 0; }
