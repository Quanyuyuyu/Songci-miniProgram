.seg {
  display: flex;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.seg-item { flex: 1; text-align: center; font-size: 28rpx; padding: 16rpx 0; color: var(--gray); }
.seg-on { background: var(--primary); color: #FFFDF6; font-weight: 600; }

.view-intro { font-size: 26rpx; color: var(--gray); line-height: 1.7; margin-bottom: 24rpx; }

/* 词史轴 */
.tl { margin-bottom: 24rpx; }
.tl-row { display: flex; align-items: stretch; }
.tl-no { width: 64rpx; flex-shrink: 0; font-size: 24rpx; color: var(--gray); font-weight: 600; padding-top: 6rpx; }
.tl-track { display: flex; flex-direction: column; align-items: center; margin: 0 20rpx; }
.tl-dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-top: 10rpx; flex-shrink: 0; }
.era-tang { background: var(--celadon); }
.era-beisong { background: var(--primary); }
.era-nansong { background: var(--cinnabar); }
.tl-line { width: 2rpx; flex: 1; background: var(--line); min-height: 32rpx; }
.tl-label { font-size: 28rpx; color: var(--ink); padding: 4rpx 0 28rpx; }
.era-legend { display: flex; padding: 0 0 12rpx 84rpx; }
.era-item { display: flex; align-items: center; margin-right: 32rpx; }
.era-item .tl-dot { margin-top: 0; margin-right: 10rpx; }
.era-name { font-size: 24rpx; color: var(--gray); }

/* 词牌家族 */
.fam { }
.fam-label { font-size: 30rpx; font-weight: 600; color: var(--primary); margin-bottom: 14rpx; }
.fam-names { display: flex; flex-wrap: wrap; }
.fam-name {
  font-size: 26rpx;
  color: var(--ink-soft);
  background: #F3EDDD;
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
  margin: 0 14rpx 14rpx 0;
  font-family: var(--font-display);
}

/* 词牌同调篇目展开 */
.fam-detail { margin-top: -8rpx; }
.fam-detail-head { font-size: 30rpx; font-weight: 600; color: var(--ink); margin-bottom: 12rpx; }
.fam-detail-meter { font-size: 26rpx; color: var(--ink-soft); line-height: 1.6; margin-bottom: 4rpx; }
.fam-detail-tone { font-size: 26rpx; color: var(--ink-soft); line-height: 1.6; margin-bottom: 16rpx; }
.fam-detail-list { border-top: 1rpx dashed var(--line); padding-top: 8rpx; }
.fam-poem { font-size: 26rpx; color: var(--primary); padding: 10rpx 0; }
.fam-week { font-size: 22rpx; color: var(--gray); margin-left: 12rpx; }
.fam-detail-empty { font-size: 24rpx; color: var(--gray); padding-top: 8rpx; }

/* 主题串联 */
.theme-head { display: flex; align-items: center; }
.theme-tag {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cinnabar);
  width: 100rpx;
  flex-shrink: 0;
}
.theme-desc { flex: 1; font-size: 24rpx; color: var(--gray); }
.theme-count { font-size: 24rpx; color: var(--primary); margin-left: 12rpx; }
.theme-list { margin-top: 16rpx; border-top: 1rpx dashed var(--line); padding-top: 8rpx; }
.theme-ci { font-size: 26rpx; color: var(--primary); padding: 10rpx 0; }
.theme-week { font-size: 22rpx; color: var(--gray); margin-left: 12rpx; }

.loading-hint { text-align: center; color: var(--gray); font-size: 26rpx; padding: 80rpx 0; }
