.page-intro { font-size: 26rpx; color: var(--gray); line-height: 1.7; margin-bottom: 24rpx; }

.cp-head { display: flex; align-items: center; }
.cp-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--primary);
  font-family: var(--font-display);
  margin-right: 16rpx;
}
.seal-celadon { background: var(--celadon); }
.cp-arrow { margin-left: auto; color: var(--gray); font-size: 32rpx; }

.cp-row { display: flex; margin-top: 18rpx; }
.cp-label {
  font-size: 24rpx;
  color: var(--cinnabar);
  flex-shrink: 0;
  width: 64rpx;
  padding-top: 4rpx;
}
.cp-text { font-size: 26rpx; color: var(--ink-soft); line-height: 1.7; flex: 1; }
.cp-items { flex: 1; }
.cp-item {
  font-size: 26rpx;
  color: var(--primary);
  padding: 6rpx 0;
  border-bottom: 1rpx dashed var(--line);
}
.cp-item:last-child { border-bottom: none; }

.loading-hint { text-align: center; color: var(--gray); font-size: 26rpx; padding: 80rpx 0; }
