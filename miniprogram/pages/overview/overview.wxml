<view class="page-body">
  <empty-state wx:if="{{error}}" icon="📜" title="课程数据未能加载" reason="{{error}}" />

  <block wx:if="{{!loading && course}}">
    <!-- 课程主数据卡 -->
    <view class="hero card">
      <view class="hero-seal">词</view>
      <view class="hero-name">{{course.name}}</view>
      <view class="hero-sub">{{course.code}} · {{course.credits}} 学分 {{course.hours}} 学时 · {{course.type}}</view>
      <view class="hero-sub">{{course.school}} · {{course.teacher}}</view>
      <view class="hero-intro">{{course.intro}}</view>
    </view>

    <!-- 成绩构成 -->
    <section-head title="成绩构成" sub="只展示规则，不计算成绩" />
    <view class="card">
      <view class="grade-bar">
        <view class="grade-seg seg-1" style="width:{{grade[0].percent}}%"></view>
        <view class="grade-seg seg-2" style="width:{{grade[1].percent}}%"></view>
        <view class="grade-seg seg-3" style="width:{{grade[2].percent}}%"></view>
        <view class="grade-seg seg-4" style="width:{{grade[3].percent}}%"></view>
      </view>
      <view class="grade-row" wx:for="{{grade}}" wx:key="item">
        <view class="grade-dot dot-{{index + 1}}"></view>
        <view class="grade-item">{{item.item}}</view>
        <view class="grade-percent">{{item.percent}}%</view>
        <view class="grade-note">{{item.note}}</view>
      </view>
    </view>

    <!-- 这门课要付出什么 -->
    <section-head title="这门课要付出什么" />
    <view class="card">
      <view class="effort" wx:for="{{effortList}}" wx:key="index">· {{item}}</view>
    </view>

    <!-- 教学周历 -->
    <section-head title="教学周历" sub="16 周授课" />
    <view class="card">
      <view class="week-row" wx:for="{{weeks}}" wx:key="w">
        <view class="week-no {{item.w === currentWeek ? 'week-no-cur' : ''}}">W{{item.w}}</view>
        <view class="week-main">
          <view class="week-theme {{item.w === currentWeek ? 'week-theme-cur' : ''}}">
            {{item.theme}}
            <text class="seal" wx:if="{{item.w === currentWeek}}">本周</text>
          </view>
          <view class="week-detail">{{item.detail}}</view>
        </view>
      </view>
      <view class="weeks-notice">{{weeksNotice}}</view>
    </view>

    <!-- 规则 -->
    <section-head title="规则三件事" />
    <view class="card" wx:if="{{rules}}">
      <view class="rule">
        <view class="rule-title">考勤</view>
        <view class="rule-text">{{rules.attendance}}</view>
      </view>
      <view class="divider"></view>
      <view class="rule">
        <view class="rule-title">迟交</view>
        <view class="rule-text">{{rules.late}}</view>
      </view>
      <view class="divider"></view>
      <view class="rule">
        <view class="rule-title">学术诚信与 AI</view>
        <view class="rule-text">{{rules.ai}}</view>
      </view>
      <view class="rule-note">{{rules.notice}}</view>
    </view>

    <disclaimer-bar text="{{disclaimer}}" />
  </block>

  <view wx:if="{{loading}}" class="loading-hint">加载中…</view>
</view>
