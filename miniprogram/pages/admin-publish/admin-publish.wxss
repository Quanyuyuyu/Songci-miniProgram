/* admin-publish 一键发布作品管理页 */
.page { padding: 32rpx 28rpx 80rpx; min-height: 100vh; box-sizing: border-box; }
.hero { padding: 8rpx 0 24rpx; }
.hero-title { font-size: 40rpx; font-weight: 600; color: #2F2620; letter-spacing: 4rpx; }
.hero-sub { margin-top: 8rpx; font-size: 24rpx; color: #8E7C66; }

.card { background: #FBF7EC; border: 1rpx solid #E8DCC0; border-radius: 16rpx; padding: 28rpx 24rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(95, 75, 50, 0.04); }
.row { display: flex; align-items: center; margin-bottom: 16rpx; }
.row:last-child { margin-bottom: 0; }
.row-label { width: 240rpx; font-size: 26rpx; color: #6B5B45; flex-shrink: 0; }
.row-value { flex: 1; font-size: 28rpx; color: #2F2620; word-break: break-all; }
.row-value.mono { font-family: "SFMono-Regular", "Consolas", monospace; font-size: 24rpx; }
.copy-btn { margin-left: 16rpx; padding: 8rpx 20rpx; font-size: 24rpx; line-height: 1.5; background: #EFE7D6; color: #2F2620; border-radius: 8rpx; border: 1rpx solid #D6C8A8; }
.copy-btn[disabled] { opacity: 0.5; }

.hint { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx dashed #E8DCC0; font-size: 22rpx; color: #8E7C66; line-height: 1.6; }
.mono { font-family: "SFMono-Regular", "Consolas", monospace; font-size: 22rpx; color: #5C4A2E; }

.primary { width: 100%; background: #8C2A2A; color: #FBF7EC; border: none; border-radius: 12rpx; padding: 24rpx 0; font-size: 30rpx; letter-spacing: 2rpx; }
.primary[disabled] { opacity: 0.6; }

.progress { margin-top: 28rpx; }
.progress-text { margin-top: 12rpx; font-size: 24rpx; color: #5C4A2E; text-align: center; }

.result { margin-top: 24rpx; padding: 20rpx; background: #F2EAD8; border-radius: 10rpx; }
.result-line { font-size: 28rpx; margin-bottom: 8rpx; }
.result-line.ok { color: #2E6B3E; }
.result-line.fail { color: #8C2A2A; }
.result-sample { margin-top: 12rpx; font-size: 22rpx; color: #6B5B45; line-height: 1.6; }
.sample-title { font-weight: 600; margin-bottom: 6rpx; }

.tip { margin-top: 16rpx; padding: 20rpx; background: #F6F1E4; border-radius: 12rpx; font-size: 22rpx; color: #6B5B45; line-height: 1.8; }
.tip view { margin-bottom: 6rpx; }
.tip view:last-child { margin-bottom: 0; }

.result-debug { margin-top: 16rpx; padding: 20rpx 24rpx; background: #FAF1E5; border: 1rpx solid #D6A878; border-radius: 10rpx; }
.debug-title { font-weight: 600; color: #8C2A2A; font-size: 28rpx; margin-bottom: 12rpx; }
.debug-line { display: flex; align-items: flex-start; font-size: 24rpx; color: #2F2620; margin-bottom: 10rpx; word-break: break-all; }
.debug-label { width: 220rpx; flex-shrink: 0; color: #6B5B45; }
.debug-value { flex: 1; font-family: "SFMono-Regular", "Consolas", monospace; background: #FFFDF6; padding: 6rpx 12rpx; border-radius: 6rpx; border: 1rpx solid #E8DCC0; word-break: break-all; user-select: text; -webkit-user-select: text; }
.debug-hint { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx dashed #D6A878; font-size: 22rpx; color: #8C5A2A; line-height: 1.6; }