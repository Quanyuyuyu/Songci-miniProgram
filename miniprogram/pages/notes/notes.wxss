.hint-bar {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-left: 6rpx solid var(--celadon);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  margin-bottom: 24rpx;
}
.note-head { font-size: 28rpx; font-weight: 600; color: var(--primary); }
.note-text { font-size: 28rpx; color: var(--ink); line-height: 1.7; margin-top: 12rpx; }
.copy-all {
  text-align: center;
  font-size: 26rpx;
  color: #FFFDF6;
  background: var(--primary);
  border-radius: 999rpx;
  padding: 18rpx 0;
  margin-top: 8rpx;
}
.loading-hint { text-align: center; color: var(--gray); font-size: 26rpx; padding: 80rpx 0; }
