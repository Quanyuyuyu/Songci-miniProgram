.page { padding: 12rpx 30rpx 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.reading-sheet { display: block; }
.work-header { padding: 18rpx 2rpx 30rpx; text-align: center; }
.work-kicker { color: var(--celadon); font-size: 22rpx; line-height: 1.4; letter-spacing: 0; margin-bottom: 18rpx; }
.work-head { display: flex; align-items: flex-start; justify-content: center; padding-left: 52rpx; }
.work-title { max-width: 580rpx; font-family: var(--font-display); font-size: 43rpx; font-weight: 600; line-height: 1.45; color: var(--ink); word-break: break-word; }
.work-seal { width: 36rpx; min-height: 54rpx; box-sizing: border-box; flex-shrink: 0; margin: 4rpx 0 0 16rpx; padding: 7rpx 5rpx; border: 2rpx solid var(--cinnabar); border-radius: 4rpx; color: var(--cinnabar); font-family: var(--font-display); font-size: 19rpx; line-height: 1.15; text-align: center; }
.title-rule { display: flex; align-items: center; width: 240rpx; margin: 22rpx auto 12rpx; }
.rule-line { height: 1rpx; background: var(--line); flex: 1; }
.rule-knot { color: var(--cinnabar); font-size: 18rpx; padding: 0 12rpx; }
.work-meta { color: var(--gray); font-size: 23rpx; line-height: 1.6; }
.meta-dot { padding: 0 14rpx; color: var(--celadon); }
.work-summary { max-width: 610rpx; margin: 22rpx auto 0; color: var(--ink-soft); font-size: 26rpx; line-height: 1.75; text-align: left; }
.source-link { display: inline-flex; align-items: center; margin-top: 22rpx; color: var(--primary); font-size: 25rpx; line-height: 1.5; }
.source-arrow { margin-left: 8rpx; color: var(--cinnabar); }
.work-body { border-top: 1rpx solid var(--line); padding-top: 8rpx; }
.sec-h { display: flex; align-items: center; margin: 42rpx 0 18rpx; color: var(--primary); font-family: var(--font-display); font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.sec-h-mark { width: 6rpx; height: 30rpx; flex-shrink: 0; margin-right: 16rpx; background: var(--cinnabar); }
.sec-h-2 { margin: 30rpx 0 14rpx; color: var(--ink); font-size: 29rpx; }
.sec-h-2 .sec-h-mark { width: 4rpx; height: 24rpx; background: var(--celadon); }
.sec-h-3 { margin: 24rpx 0 10rpx; color: var(--ink-soft); font-family: var(--font-sans); font-size: 27rpx; }
.sec-h-3 .sec-h-mark { width: 4rpx; height: 20rpx; background: var(--line); }
.sec-p { margin: 19rpx 0; color: var(--ink-soft); font-size: 30rpx; line-height: 1.96; text-align: justify; white-space: pre-wrap; word-break: break-word; }
.sec-quote { margin: 28rpx 0; padding: 20rpx 24rpx; border-left: 5rpx solid var(--celadon); background: #F1EBDD; color: #3E4845; font-family: var(--font-sans); font-size: 29rpx; line-height: 1.95; white-space: pre-wrap; word-break: break-word; }
.sec-note { margin: 12rpx 0 20rpx; padding-left: 18rpx; border-left: 3rpx solid var(--line); color: var(--gray); font-size: 23rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-word; }
.image-block { margin: 30rpx 0 34rpx; }
.sec-img { display: block; width: 100%; box-sizing: border-box; border: 1rpx solid #D7CEB9; border-radius: 4rpx; background: #EEE8DA; }
.sec-img:active { opacity: 0.84; }
.image-caption { margin-top: 11rpx; color: var(--gray); font-family: var(--font-sans); font-size: 22rpx; line-height: 1.5; text-align: center; }
.collecting { text-align: center; padding: 110rpx 40rpx; }
.c-mark { width: 66rpx; height: 66rpx; margin: 0 auto; border: 2rpx solid var(--cinnabar); border-radius: 4rpx; color: var(--cinnabar); font-family: var(--font-display); font-size: 34rpx; line-height: 66rpx; }
.c-title { margin-top: 22rpx; color: var(--ink); font-size: 32rpx; }
.c-reason { margin-top: 12rpx; color: var(--gray); font-size: 25rpx; }
.loading-hint { text-align: center; color: var(--gray); font-size: 26rpx; padding: 90rpx 0; }
