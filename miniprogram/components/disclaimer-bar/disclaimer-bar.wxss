.disclaimer {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--line, #E4DDCB);
}
.disclaimer-seal {
  flex-shrink: 0;
  color: #FFFDF6;
  background: var(--cinnabar, #A03B2C);
  border-radius: 6rpx;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
}
.disclaimer-text {
  font-size: 22rpx;
  color: var(--gray, #6F685F);
  line-height: 1.6;
}
