.empty {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon { font-size: 64rpx; margin-bottom: 20rpx; }
.empty-title { font-size: 30rpx; color: var(--ink-soft, #4A443A); font-weight: 600; }
.empty-reason { font-size: 26rpx; color: var(--gray, #6F685F); margin-top: 12rpx; text-align: center; }
